{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "@cloudflare/workers-types", "vinext/types"],
    "paths": {
      "@/*": ["./*"],
      "@mridul/supabase/server": ["../../packages/supabase/src/server.ts"],
      "@mridul/*": ["../../packages/*/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/**/*.ts",
    ".vinext/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
