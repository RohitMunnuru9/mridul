# Patterns are intentionally unanchored so they match inside apps/* and
# packages/* as well as at the repo root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# framework build output
.next/
.vinext/
out/
dist/
.output/
*.tsbuildinfo

# cloudflare / wrangler local state
.wrangler/

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment — never commit secrets
.env
.env.*
!.env.example
# Wrangler's secret file. The storefront dev server runs on workerd, which does
# not see .env.local — server-side secrets reach it through this instead.
.dev.vars
.dev.vars.*

# deployment and generated files
.vercel/
next-env.d.ts
outputs/
work/

# local visual QA captures
mobile-*.jpg
desktop-*.jpg
