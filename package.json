{
  "name": "mridulbymr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/storefront",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build --workspace apps/storefront",
    "build:admin": "npm run build --workspace apps/admin",
    "start": "npm run start --workspace apps/storefront",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit -p apps/storefront && tsc --noEmit -p apps/admin",
    "seed": "tsx scripts/seed-supabase.ts",
    "build:vercel": "npm run build:vercel --workspace apps/storefront",
    "build:vercel:admin": "npm run build:vercel --workspace apps/admin"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "dotenv": "^17.4.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
