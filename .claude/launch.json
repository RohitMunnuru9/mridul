{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mridulbymr-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "env": {
        "NODE_OPTIONS": "--inspect-port=0"
      }
    },
    {
      "name": "mridulbymr-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3001,
      "env": {
        "NODE_OPTIONS": "--inspect-port=0"
      }
    }
  ]
}
