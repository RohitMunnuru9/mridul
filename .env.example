# Copy this file to .env.local and fill in the values from your Supabase
# dashboard. .env.local is gitignored and must never be committed.
#
#   Dashboard -> Project Settings -> API
#
# Newer Supabase projects label these "Publishable key" and "Secret key"
# rather than "anon" and "service_role". They are the same two things.

# ---------------------------------------------------------------------------
# Safe to expose. These are compiled into the browser bundle by design, and
# they are useless on their own — row-level security is what protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public storefront origin used for email verification and Google OAuth callbacks.
# Add the same callback URLs in Supabase Auth -> URL Configuration.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# SECRET. Server-side only.
#
# This key bypasses row-level security completely — it can read and write
# every row belonging to every customer. It is what writes orders after the
# server has priced them.
#
# Never prefix it with NEXT_PUBLIC_. Never import it into a client component.
# Never paste it into a chat, an issue, or a screenshot. If it leaks, rotate
# it immediately in the dashboard.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---------------------------------------------------------------------------
# SECRET. Server-side only. The shop assistant ("Ask us" in the corner).
#
# A Google AI Studio key: https://aistudio.google.com/apikey
# Read only by the /api/chat route handler. Without it the assistant shows the
# WhatsApp hand-off instead of a chat, so the shop works either way.
#
# Set a spend limit on the key's Google Cloud project: it answers a public
# endpoint. Never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional. The model the assistant uses; omit for the default (gemini-3.6-flash).
# Here so a model rename never needs a code change.
# GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Added later, as each integration is wired up.
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

